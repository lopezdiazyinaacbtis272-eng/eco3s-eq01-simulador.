<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Simulador Solar Escolar - EQ01</title>

    <script src="https://cdn.tailwindcss.com"></script>
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Outfit', 'sans-serif'],
                    },
                    colors: {
                        solar: {
                            50: '#fffbeb',
                            100: '#fef3c7',
                            500: '#f59e0b',
                            600: '#d97706',
                            700: '#b45309',
                            800: '#92400e',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Outfit', sans-serif;
            background: linear-gradient(135deg, #fef3c7 0%, #fff7ed 50%, #e0f2fe 100%);
            min-height: 100vh;
        }

        input[type=range] {
            accent-color: #d97706;
        }

        @media print {
            body * {
                visibility: hidden;
            }
            #app-container, #app-container * {
                visibility: visible;
            }
            #app-container {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
            }
        }
    </style>
</head>
<body class="text-slate-800 min-h-screen flex flex-col">


    <nav class="bg-slate-900 text-white shadow-lg sticky top-0 z-50">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">

                <div class="flex items-center gap-3 cursor-pointer" onclick="mostrarSeccion('simulador')">
                    <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-amber-500 to-orange-400 flex items-center justify-center text-white text-lg shadow-md">
                        <i class="fa-solid fa-sun"></i>
                    </div>
                    <span class="font-bold text-lg tracking-wide text-amber-400">Simulador Solar</span>
                </div>

                <div class="hidden md:flex space-x-6 text-sm font-medium">
                    <button onclick="mostrarSeccion('simulador')" class="hover:text-amber-400 transition-colors py-2 border-b-2 border-transparent hover:border-amber-400">
                        <i class="fa-solid fa-calculator mr-1"></i> Simulador
                    </button>
                    <button onclick="mostrarSeccion('como-funciona')" class="hover:text-amber-400 transition-colors py-2 border-b-2 border-transparent hover:border-amber-400">
                        <i class="fa-solid fa-bolt mr-1"></i> ¿Cómo funciona?
                    </button>
                    <button onclick="mostrarSeccion('como-ahorrar')" class="hover:text-amber-400 transition-colors py-2 border-b-2 border-transparent hover:border-amber-400">
                        <i class="fa-solid fa-piggy-bank mr-1"></i> ¿Cómo ahorrar?
                    </button>
                </div>

                <div class="md:hidden relative">
                    <button id="menuBtn" onclick="toggleMenu()" class="text-slate-300 hover:text-white focus:outline-none p-2 rounded-lg bg-slate-800 border border-slate-700">
                        <i class="fa-solid fa-bars text-xl"></i>
                    </button>

                    <div id="dropdownMenu" class="hidden absolute right-0 mt-2 w-56 bg-slate-800 rounded-2xl shadow-xl border border-slate-700 py-2 z-50 backdrop-blur-lg">
                        <button onclick="mostrarSeccion('simulador'); toggleMenu();" class="w-full text-left px-4 py-2.5 text-sm font-medium hover:bg-slate-700 hover:text-amber-400 flex items-center gap-2">
                            <i class="fa-solid fa-calculator text-amber-500"></i> Simulador
                        </button>
                        <button onclick="mostrarSeccion('como-funciona'); toggleMenu();" class="w-full text-left px-4 py-2.5 text-sm font-medium hover:bg-slate-700 hover:text-amber-400 flex items-center gap-2">
                            <i class="fa-solid fa-bolt text-amber-500"></i> ¿Cómo funciona?
                        </button>
                        <button onclick="mostrarSeccion('como-ahorrar'); toggleMenu();" class="w-full text-left px-4 py-2.5 text-sm font-medium hover:bg-slate-700 hover:text-amber-400 flex items-center gap-2">
                            <i class="fa-solid fa-piggy-bank text-amber-500"></i> ¿Cómo ahorrar?
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <main class="flex-grow p-4 md:p-8 flex items-center justify-center">
        <div class="max-w-5xl w-full">

            <div id="sec-simulador" class="grid grid-cols-1 lg:grid-cols-12 gap-6 bg-white/90 backdrop-blur-md rounded-3xl p-6 md:p-8 shadow-2xl border border-white/80">
                
                <header class="lg:col-span-12 flex flex-col md:flex-row items-center justify-between border-b border-amber-200/80 pb-5 gap-4">
                    <div class="flex items-center gap-3">
                        <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-amber-500 to-orange-400 flex items-center justify-center text-white text-2xl shadow-md shadow-amber-500/20">
                            <i class="fa-solid fa-sun"></i>
                        </div>
                        <div>
                            <h1 class="text-2xl md:text-3xl font-bold bg-gradient-to-r from-amber-700 via-orange-600 to-amber-900 bg-clip-text text-transparent">
                                Simulador Solar Escolar
                            </h1>
                            <p class="text-sm font-medium text-amber-800/80">Proyecto Educativo &bull; Equipo EQ01</p>
                        </div>
                    </div>
                    
                    <div class="flex items-center gap-2 bg-amber-100/80 text-amber-900 text-xs font-semibold px-4 py-2 rounded-full border border-amber-300/60">
                        <i class="fa-solid fa-leaf text-emerald-600"></i>
                        <span>Calculadora de Energía Renovable</span>
                    </div>
                </header>

                <div class="lg:col-span-7 flex flex-col gap-4">
                    <div class="relative bg-gradient-to-b from-sky-400 via-sky-200 to-amber-50 rounded-2xl overflow-hidden shadow-inner border border-sky-300/50">
                        
                        <div class="absolute top-3 left-3 z-10 bg-white/90 backdrop-blur-md px-3 py-1.5 rounded-xl border border-white/80 shadow-sm flex items-center gap-2">
                            <span id="statusIndicator" class="w-2.5 h-2.5 rounded-full bg-slate-400"></span>
                            <span id="statusText" class="text-xs font-semibold text-slate-700">Sin paneles instalados</span>
                        </div>
                        <canvas id="canvasCasa" class="w-full h-auto block" width="600" height="380"></canvas>
                    </div>

                    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                        <div class="bg-amber-50/90 border border-amber-200 p-3 rounded-xl text-center shadow-sm">
                            <p class="text-xs font-semibold text-amber-800">Generación Mensual</p>
                            <p class="text-lg font-bold text-amber-600 mt-0.5"><span id="metricGen">0</span> <span class="text-xs font-normal">kWh</span></p>
                        </div>
                        <div class="bg-emerald-50/90 border border-emerald-200 p-3 rounded-xl text-center shadow-sm">
                            <p class="text-xs font-semibold text-emerald-800">Ahorro Estimado</p>
                            <p class="text-lg font-bold text-emerald-600 mt-0.5">$<span id="metricAhorro">0</span> <span class="text-xs font-normal">MXN</span></p>
                        </div>
                        <div class="bg-sky-50/90 border border-sky-200 p-3 rounded-xl text-center shadow-sm">
                            <p class="text-xs font-semibold text-sky-800">CO₂ Evitado</p>
                            <p class="text-lg font-bold text-sky-600 mt-0.5"><span id="metricCo2">0</span> <span class="text-xs font-normal">kg</span></p>
                        </div>
                        <div class="bg-lime-50/90 border border-lime-200 p-3 rounded-xl text-center shadow-sm">
                            <p class="text-xs font-semibold text-lime-800">Bosque Equiv.</p>
                            <p class="text-lg font-bold text-lime-600 mt-0.5"><span id="metricArboles">0</span> <span class="text-xs font-normal">árboles</span></p>
                        </div>
                    </div>
                </div>

                <div class="lg:col-span-5 flex flex-col justify-between gap-5 bg-slate-50/90 rounded-2xl p-5 border border-slate-200/80 shadow-sm">
                    
                    <div class="space-y-4">
                        <h2 class="text-lg font-bold text-slate-800 flex items-center gap-2 border-b border-slate-200 pb-2">
                            <i class="fa-solid fa-sliders text-amber-600"></i> Configuración del Sistema
                        </h2>

                        <div class="space-y-1">
                            <div class="flex justify-between items-center text-xs font-semibold text-slate-700">
                                <label for="consumo">Consumo de luz (kWh/mes):</label>
                                <span id="consumoVal" class="text-amber-600 font-bold">250 kWh</span>
                            </div>
                            <input type="number" id="consumo" min="10" max="2000" value="250" class="w-full px-3 py-2 bg-white border border-slate-300 rounded-xl text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition-all">
                        </div>

                        <div class="space-y-1">
                            <div class="flex justify-between items-center text-xs font-semibold text-slate-700">
                                <label for="numPaneles">Cantidad de Paneles (450W c/u):</label>
                                <span id="panelesVal" class="text-amber-600 font-bold">2 paneles</span>
                            </div>
                            <input type="range" id="numPaneles" min="1" max="10" value="2" class="w-full h-2 bg-amber-200 rounded-lg appearance-none cursor-pointer">
                        </div>

                        <div class="space-y-1">
                            <div class="flex justify-between items-center text-xs font-semibold text-slate-700">
                                <label for="horasSol">Horas de Sol Pico al día:</label>
                                <span id="horasSolVal" class="text-amber-600 font-bold">5.0 hrs</span>
                            </div>
                            <input type="range" id="horasSol" min="3" max="7" step="0.5" value="5.0" class="w-full h-2 bg-amber-200 rounded-lg appearance-none cursor-pointer">
                        </div>

                        <div class="space-y-1">
                            <label for="tarifa" class="block text-xs font-semibold text-slate-700">Tarifa Eléctrica CFE Estimada:</label>
                            <select id="tarifa" class="w-full px-3 py-2 bg-white border border-slate-300 rounded-xl text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500">
                                <option value="1.05">Tarifa 01 - Básica ($1.05 MXN / kWh)</option>
                                <option value="1.85" selected>Tarifa 01 - Intermedia ($1.85 MXN / kWh)</option>
                                <option value="3.50">Tarifa DAC - Alto Consumo ($3.50 MXN / kWh)</option>
                            </select>
                        </div>
                    </div>

                    <div class="bg-amber-50/70 rounded-xl p-4 border border-amber-200/80 space-y-2">
                        <h3 class="text-xs font-bold text-amber-900 uppercase tracking-wider flex items-center justify-between">
                            <span>Resumen Financiero y Ambiental</span>
                            <i class="fa-solid fa-chart-pie text-amber-600"></i>
                        </h3>
                        <div class="text-xs space-y-1.5 text-slate-700">
                            <div class="flex justify-between border-b border-amber-200/50 pb-1">
                                <span>Ahorro estimado en 1 año:</span>
                                <strong class="text-slate-900">$<span id="ahorroAnual">0</span> MXN</strong>
                            </div>
                            <div class="flex justify-between border-b border-amber-200/50 pb-1">
                                <span>Inversión aprox. equipamiento:</span>
                                <strong class="text-slate-900">$<span id="costoInversion">0</span> MXN</strong>
                            </div>
                            <div class="flex justify-between border-b border-amber-200/50 pb-1">
                                <span>Tiempo de retorno (ROI):</span>
                                <strong class="text-emerald-600"><span id="roiAnios">0</span> años</strong>
                            </div>
                            <div class="flex justify-between">
                                <span>Porcentaje de consumo cubierto:</span>
                                <strong id="porcentajeCobertura" class="text-amber-700">0%</strong>
                            </div>
                        </div>
                    </div>

                    <div class="flex gap-2">
                        <button onclick="calcularAhorro()" class="flex-1 bg-gradient-to-r from-amber-600 via-orange-500 to-amber-600 hover:from-amber-700 hover:to-orange-600 text-white font-semibold py-3 px-4 rounded-xl shadow-md shadow-amber-600/20 transition-all flex items-center justify-center gap-2">
                            <i class="fa-solid fa-calculator"></i>
                            <span>Calcular Ahorro</span>
                        </button>
                        <button onclick="imprimirReporte()" title="Imprimir o Guardar Reporte" class="bg-slate-200 hover:bg-slate-300 text-slate-700 p-3 rounded-xl transition-all flex items-center justify-center">
                            <i class="fa-solid fa-print"></i>
                        </button>
                    </div>

                </div>

                <div id="messageBox" class="hidden lg:col-span-12 bg-amber-100 border-l-4 border-amber-500 text-amber-900 p-4 rounded-xl flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <i class="fa-solid fa-triangle-exclamation text-amber-600 text-xl"></i>
                        <span id="messageText" class="text-sm font-medium">Por favor ingresa datos válidos.</span>
                    </div>
                    <button onclick="cerrarMensaje()" class="text-amber-800 hover:text-amber-900 font-bold text-sm">Entendido</button>
                </div>

            </div>

            <div id="sec-como-funciona" class="hidden space-y-6">
                <div class="bg-white/90 backdrop-blur-md rounded-3xl p-6 md:p-8 shadow-2xl border border-white/80">
                    <h2 class="text-2xl font-bold text-slate-800 mb-4 flex items-center gap-3">
                        <i class="fa-solid fa-bolt text-amber-500 text-3xl"></i>
                        <span>¿Cómo funciona la energía solar?</span>
                    </h2>
                    <p class="text-slate-600 mb-6 font-medium">
                        Los paneles solares aprovechan la luz del sol mediante un proceso muy sencillo:[cite: 1]
                    </p>

                    <ul class="space-y-4 text-slate-700 text-sm md:text-base">
                        <li class="flex items-start gap-3 bg-amber-50/60 p-4 rounded-2xl border border-amber-100">
                            <span class="text-amber-600 font-bold text-lg">•</span>
                            <div>
                                <strong class="text-slate-900">Celdas fotovoltaicas:</strong> Los paneles están formados por celdas que reciben los rayos del sol (fotones) y los convierten en energía eléctrica continua.[cite: 1]
                            </div>
                        </li>
                        <li class="flex items-start gap-3 bg-amber-50/60 p-4 rounded-2xl border border-amber-100">
                            <span class="text-amber-600 font-bold text-lg">•</span>
                            <div>
                                <strong class="text-slate-900">Inversor solar:</strong> Transforma esa corriente continua en corriente alterna, que es el tipo de electricidad que usan tus electrodomésticos.[cite: 1]
                            </div>
                        </li>
                        <li class="flex items-start gap-3 bg-amber-50/60 p-4 rounded-2xl border border-amber-100">
                            <span class="text-amber-600 font-bold text-lg">•</span>
                            <div>
                                <strong class="text-slate-900">Uso inmediato:</strong> La energía producida alimenta los focos, televisión o refrigerador de tu casa durante el día.[cite: 1]
                            </div>
                        </li>
                    </ul>

                    <div class="mt-8 flex justify-end">
                        <button onclick="mostrarSeccion('simulador')" class="bg-amber-600 hover:bg-amber-700 text-white font-semibold py-2.5 px-5 rounded-xl shadow-md transition-all flex items-center gap-2 text-sm">
                            <span>Ir al Simulador</span>
                            <i class="fa-solid fa-arrow-right"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div id="sec-como-ahorrar" class="hidden space-y-6">
                <div class="bg-white/90 backdrop-blur-md rounded-3xl p-6 md:p-8 shadow-2xl border border-white/80">
                    <h2 class="text-2xl font-bold text-slate-800 mb-4 flex items-center gap-3">
                        <i class="fa-solid fa-piggy-bank text-amber-500 text-3xl"></i>
                        <span>¿Cómo ahorrar con paneles solares?</span>
                    </h2>
                    <p class="text-slate-600 mb-6 font-medium">
                        Para maximizar tu ahorro energético y económico, ten en cuenta estas recomendaciones:[cite: 1]
                    </p>

                    <ul class="space-y-4 text-slate-700 text-sm md:text-base">
                        <li class="flex items-start gap-3 bg-amber-50/60 p-4 rounded-2xl border border-amber-100">
                            <span class="text-amber-600 font-bold text-lg">•</span>
                            <div>
                                <strong class="text-slate-900">Aprovecha las horas de sol:</strong> Intenta usar la lavadora u otros aparatos de alto consumo a mediodía, cuando los paneles generan más electricidad.[cite: 1]
                            </div>
                        </li>
                        <li class="flex items-start gap-3 bg-amber-50/60 p-4 rounded-2xl border border-amber-100">
                            <span class="text-amber-600 font-bold text-lg">•</span>
                            <div>
                                <strong class="text-slate-900">Orientación e inclinación adecuada:</strong> Coloca los paneles mirando hacia el sur (o según tu ubicación geográfica) y sin sombras de árboles o edificios.[cite: 1]
                            </div>
                        </li>
                        <li class="flex items-start gap-3 bg-amber-50/60 p-4 rounded-2xl border border-amber-100">
                            <span class="text-amber-600 font-bold text-lg">•</span>
                            <div>
                                <strong class="text-slate-900">Mantenimiento periódico:</strong> Mantén la superficie de los paneles limpia de polvo y hojas para mantener su eficiencia al máximo.[cite: 1]
                            </div>
                        </li>
                        <li class="flex items-start gap-3 bg-amber-50/60 p-4 rounded-2xl border border-amber-100">
                            <span class="text-amber-600 font-bold text-lg">•</span>
                            <div>
                                <strong class="text-slate-900">Reducción de consumo de red:</strong> Toda la energía que generas tú mismo reduce directamente el dinero que pagas en tu recibo eléctrico.[cite: 1]
                            </div>
                        </li>
                    </ul>

                    <div class="mt-8 flex justify-end">
                        <button onclick="mostrarSeccion('simulador')" class="bg-amber-600 hover:bg-amber-700 text-white font-semibold py-2.5 px-5 rounded-xl shadow-md transition-all flex items-center gap-2 text-sm">
                            <span>Probar Simulador</span>
                            <i class="fa-solid fa-arrow-right"></i>
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </main>

    <script>

        const canvas = document.getElementById('canvasCasa');
        const ctx = canvas.getContext('2d');

        const inputConsumo = document.getElementById('consumo');
        const inputPaneles = document.getElementById('numPaneles');
        const inputHorasSol = document.getElementById('horasSol');
        const selectTarifa = document.getElementById('tarifa');

        const valConsumo = document.getElementById('consumoVal');
        const valPaneles = document.getElementById('panelesVal');
        const valHorasSol = document.getElementById('horasSolVal');

        function toggleMenu() {
            const menu = document.getElementById('dropdownMenu');
            menu.classList.toggle('hidden');
        }

        function mostrarSeccion(nombre) {
            document.getElementById('sec-simulador').classList.add('hidden');
            document.getElementById('sec-como-funciona').classList.add('hidden');
            document.getElementById('sec-como-ahorrar').classList.add('hidden');

            document.getElementById(`sec-${nombre}`).classList.remove('hidden');

            if (nombre === 'simulador') {
                const numPaneles = parseInt(inputPaneles.value);
                dibujarCasaEstatica(numPaneles > 0, numPaneles);
            }
        }

        window.onload = function() {
            setupEventListeners();
            syncLabels();
            calcularAhorro();
        };

        function syncLabels() {
            valConsumo.innerText = `${inputConsumo.value || 0} kWh`;
            valPaneles.innerText = `${inputPaneles.value} ${inputPaneles.value == 1 ? 'panel' : 'paneles'}`;
            valHorasSol.innerText = `${parseFloat(inputHorasSol.value).toFixed(1)} hrs`;
        }

        function setupEventListeners() {
            [inputConsumo, inputPaneles, inputHorasSol, selectTarifa].forEach(elem => {
                elem.addEventListener('input', () => {
                    syncLabels();
                    calcularAhorro();
                });
            });

            window.addEventListener('resize', () => {
                const numPaneles = parseInt(inputPaneles.value);
                dibujarCasaEstatica(numPaneles > 0, numPaneles);
            });
        }

        function mostrarMensaje(texto) {
            const msgBox = document.getElementById('messageBox');
            const msgText = document.getElementById('messageText');
            msgText.innerText = texto;
            msgBox.classList.remove('hidden');
        }

        function cerrarMensaje() {
            document.getElementById('messageBox').classList.add('hidden');
        }

        function calcularAhorro() {
            let consumoVal = parseFloat(inputConsumo.value);

            if (isNaN(consumoVal) || consumoVal <= 0) {
                mostrarMensaje("Por favor ingresa un consumo mensual válido mayor a 0 kWh.");
                dibujarCasaEstatica(false, 0);
                return;
            } else {
                cerrarMensaje();
            }

            const numPaneles = parseInt(inputPaneles.value);
            const horasSol = parseFloat(inputHorasSol.value);
            const precioTarifa = parseFloat(selectTarifa.value);

            const potenciaTotalKW = numPaneles * 0.45;
            const generacionMensual = potenciaTotalKW * horasSol * 30 * 0.82;

            const generacionAprovechada = Math.min(generacionMensual, consumoVal);
            const ahorroMensualDinero = generacionAprovechada * precioTarifa;
            const ahorroAnualDinero = ahorroMensualDinero * 12;

            const co2Evitado = generacionMensual * 0.435;
            const arbolesEquivalentes = (co2Evitado * 12) / 20;

            const costoEstimadoPorPanel = 6500;
            const inversionTotal = numPaneles * costoEstimadoPorPanel;
            const roiAnios = ahorroAnualDinero > 0 ? (inversionTotal / ahorroAnualDinero).toFixed(1) : 0;
            const porcentajeCobertura = Math.min(100, Math.round((generacionMensual / consumoVal) * 100));

            document.getElementById('metricGen').innerText = generacionMensual.toFixed(1);
            document.getElementById('metricAhorro').innerText = ahorroMensualDinero.toFixed(2);
            document.getElementById('metricCo2').innerText = co2Evitado.toFixed(1);
            document.getElementById('metricArboles').innerText = arbolesEquivalentes.toFixed(1);

            document.getElementById('ahorroAnual').innerText = ahorroAnualDinero.toLocaleString('es-MX', {maximumFractionDigits: 2});
            document.getElementById('costoInversion').innerText = inversionTotal.toLocaleString('es-MX');
            document.getElementById('roiAnios').innerText = roiAnios;
            document.getElementById('porcentajeCobertura').innerText = `${porcentajeCobertura}%`;

            const statusIndicator = document.getElementById('statusIndicator');
            const statusText = document.getElementById('statusText');

            if (numPaneles > 0) {
                statusIndicator.className = "w-2.5 h-2.5 rounded-full bg-emerald-500";
                statusText.innerText = `${numPaneles} ${numPaneles === 1 ? 'Panel Activo' : 'Paneles Activos'}`;
            } else {
                statusIndicator.className = "w-2.5 h-2.5 rounded-full bg-slate-400";
                statusText.innerText = "Sin paneles instalados";
            }

            dibujarCasaEstatica(numPaneles > 0, numPaneles);
        }

        function dibujarCasaEstatica(conPaneles, cantidadPaneles) {
            const w = canvas.width;
            const h = canvas.height;

            ctx.clearRect(0, 0, w, h);

            let skyGradient = ctx.createLinearGradient(0, 0, 0, h);
            skyGradient.addColorStop(0, '#38bdf8');
            skyGradient.addColorStop(0.6, '#bae6fd');
            skyGradient.addColorStop(1, '#fef3c7');
            ctx.fillStyle = skyGradient;
            ctx.fillRect(0, 0, w, h);

            const sunX = 90;
            const sunY = 80;

            let sunGlow = ctx.createRadialGradient(sunX, sunY, 10, sunX, sunY, 45);
            sunGlow.addColorStop(0, 'rgba(253, 224, 71, 0.9)');
            sunGlow.addColorStop(0.6, 'rgba(251, 146, 60, 0.3)');
            sunGlow.addColorStop(1, 'rgba(255, 255, 255, 0)');
            ctx.fillStyle = sunGlow;
            ctx.beginPath();
            ctx.arc(sunX, sunY, 45, 0, Math.PI * 2);
            ctx.fill();

            ctx.fillStyle = '#FBBF24';
            ctx.beginPath();
            ctx.arc(sunX, sunY, 24, 0, Math.PI * 2);
            ctx.fill();

            ctx.strokeStyle = '#F97316';
            ctx.lineWidth = 3;
            ctx.lineCap = 'round';
            for (let i = 0; i < 8; i++) {
                const angle = (i * Math.PI) / 4;
                const x1 = sunX + Math.cos(angle) * 30;
                const y1 = sunY + Math.sin(angle) * 30;
                const x2 = sunX + Math.cos(angle) * 39;
                const y2 = sunY + Math.sin(angle) * 39;
                ctx.beginPath();
                ctx.moveTo(x1, y1);
                ctx.lineTo(x2, y2);
                ctx.stroke();
            }

            dibujarNubeEstatica(310, 65, 0.85);
            dibujarNubeEstatica(470, 95, 0.65);

            let grassGradient = ctx.createLinearGradient(0, 290, 0, h);
            grassGradient.addColorStop(0, '#4ade80');
            grassGradient.addColorStop(1, '#15803d');
            ctx.fillStyle = grassGradient;
            ctx.fillRect(0, 280, w, h - 280);

            const houseX = 180;
            const houseY = 160;
            const houseW = 240;
            const houseH = 130;

            ctx.fillStyle = '#fef08a';
            ctx.fillRect(houseX, houseY, houseW, houseH);
            ctx.strokeStyle = '#fde047';
            ctx.lineWidth = 2;
            ctx.strokeRect(houseX, houseY, houseW, houseH);

            ctx.fillStyle = '#78350f';
            ctx.fillRect(houseX + 30, houseY + 50, 40, 80);
            ctx.fillStyle = '#fbbf24';
            ctx.beginPath();
            ctx.arc(houseX + 63, houseY + 92, 3, 0, Math.PI * 2);
            ctx.fill();

            ctx.fillStyle = '#e0f2fe';
            ctx.fillRect(houseX + 140, houseY + 45, 60, 50);
            ctx.strokeStyle = '#0284c7';
            ctx.lineWidth = 3;
            ctx.strokeRect(houseX + 140, houseY + 45, 60, 50);

            ctx.beginPath();
            ctx.moveTo(houseX - 25, houseY);
            ctx.lineTo(houseX + houseW / 2, houseY - 80);
            ctx.lineTo(houseX + houseW + 25, houseY);
            ctx.closePath();
            ctx.fillStyle = '#f97316';
            ctx.fill();
            ctx.strokeStyle = '#c2410c';
            ctx.lineWidth = 3;
            ctx.stroke();

            if (conPaneles && cantidadPaneles > 0) {
                const maxPanelesPorFila = 5;
                const panelesFila1 = Math.min(cantidadPaneles, maxPanelesPorFila);
                const panelesFila2 = Math.max(0, cantidadPaneles - maxPanelesPorFila);

                dibujarFilaPaneles(panelesFila1, houseX + 20, houseY - 35, 38, 22);
                if (panelesFila2 > 0) {
                    dibujarFilaPaneles(panelesFila2, houseX + 35, houseY - 62, 32, 18);
                }
            }
        }

        function dibujarFilaPaneles(cantidad, startX, startY, pWidth, pHeight) {
            for (let i = 0; i < cantidad; i++) {
                const px = startX + (i * (pWidth + 6));
                const py = startY;

                ctx.fillStyle = '#1e3a8a';
                ctx.fillRect(px, py, pWidth, pHeight);

                ctx.strokeStyle = '#38bdf8';
                ctx.lineWidth = 1.5;
                ctx.strokeRect(px, py, pWidth, pHeight);

                ctx.strokeStyle = '#60a5fa';
                ctx.lineWidth = 0.5;
                ctx.beginPath();
                ctx.moveTo(px + pWidth / 2, py);
                ctx.lineTo(px + pWidth / 2, py + pHeight);
                ctx.moveTo(px, py + pHeight / 2);
                ctx.lineTo(px + pWidth, py + pHeight / 2);
                ctx.stroke();
            }
        }

        function dibujarNubeEstatica(x, y, scale) {
            ctx.save();
            ctx.translate(x, y);
            ctx.scale(scale, scale);
            ctx.fillStyle = 'rgba(255, 255, 255, 0.85)';
            ctx.beginPath();
            ctx.arc(0, 0, 20, 0, Math.PI * 2);
            ctx.arc(20, -10, 25, 0, Math.PI * 2);
            ctx.arc(45, 0, 20, 0, Math.PI * 2);
            ctx.arc(22, 10, 18, 0, Math.PI * 2);
            ctx.closePath();
            ctx.fill();
            ctx.restore();
        }

        function imprimirReporte() {
            window.print();
        }
    </script>
